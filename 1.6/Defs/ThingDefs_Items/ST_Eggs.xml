<Defs>
	<ThingDef ParentName="EggUnfertBase">
		<defName>ST_ParrotEggUnfertilized</defName>
		<label>parrot egg (unfert.)</label>
		<description>An unfertilized parrot egg. It can be eaten raw, but it's much, much better cooked.</description>
		<graphicData>
			<color>(225,220,200)</color>
		</graphicData>
		<statBases>
			<MarketValue>6.0</MarketValue>
		</statBases>
		<tradeTags>
			<li>ST_Eggs</li>
		</tradeTags>
	</ThingDef>

	<ThingDef ParentName="EggFertBase">
		<defName>ST_ParrotEggFertilized</defName>
		<label>parrot egg (fert.)</label>
		<description>A fertilized parrot egg. If all goes well, it should hatch into a parrot. It can be eaten raw, but it's much better cooked.</description>
		<graphicData>
			<color>(225,220,200)</color>
		</graphicData>
		<statBases>
			<MarketValue>8.0</MarketValue>
		</statBases>
		<comps>
			<li Class="CompProperties_Hatcher">
				<hatcherDaystoHatch>5</hatcherDaystoHatch>
				<hatcherPawn>ST_Parrot</hatcherPawn>
			</li>
		</comps>
		<tradeTags>
			<li>ST_Eggs</li>
		</tradeTags>
	</ThingDef>
	
