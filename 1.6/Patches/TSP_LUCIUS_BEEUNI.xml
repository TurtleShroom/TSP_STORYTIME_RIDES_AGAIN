<?xml version="1.0" encoding="utf-8"?>

<Patch>
	<!-- Biomes Bees apiaries only count Beauty-purpose plants by default; white list MO crops and alchemy plants explicitly. -->
	<!-- Derived from an enemy Patch: https://www.steamcommunity.com/sharedfiles/filedetails/?id=3746323752 -->
	<Operation Class="PatchOperationConditional">
		<xpath>Defs/ThingDef[defName="BMT_WildBeehive" or defName="BMT_MedievalApiary" or defName="BMT_IndustrialApiary" or defName="BMT_UltratechApiary"]/comps/li[@Class="BiomesBees.CompProperties_BeesHive"]/whitelist/li[.="ST_CookingAppleTree"]</xpath>
		<nomatch Class="PatchOperationAdd">
			<xpath>Defs/ThingDef[defName="BMT_WildBeehive" or defName="BMT_MedievalApiary" or defName="BMT_IndustrialApiary" or defName="BMT_UltratechApiary"]/comps/li[@Class="BiomesBees.CompProperties_BeesHive"]/whitelist</xpath>
			<success>Always</success>
			<value>
				<li MayRequire="TSP.Isgengriff.Storytime">Plant_Bean</li>
				<li MayRequire="TSP.Isgengriff.Storytime">Plant_Botox</li>
				<li MayRequire="TSP.Isgengriff.Storytime">ST_CabbagePlant</li>
				<li MayRequire="TSP.Isgengriff.Storytime">ST_CookingAppleTree</li>
				<li MayRequire="TSP.Isgengriff.Storytime">ST_OrangeTree</li>
				<li MayRequire="TSP.Isgengriff.Storytime">ST_LemonTree</li>
				<li MayRequire="TSP.Isgengriff.Storytime">ST_LimeTree</li>
				<li MayRequire="TSP.Isgengriff.Storytime">TSP_ST_CitronTree</li>
				<li MayRequire="TSP.Isgengriff.Storytime">Plant_Gnome</li>
				<li MayRequire="TSP.Isgengriff.Storytime">ST_Plant_Sugar</li>
				<li MayRequire="TSP.Isgengriff.Storytime">Herba</li>
				<li MayRequire="TSP.Isgengriff.Storytime">Herb_Guam</li>
				<li MayRequire="TSP.Isgengriff.Storytime">Herb_Harralander</li>
				<li MayRequire="TSP.Isgengriff.Storytime">Herb_Lantadyme</li>
				<li MayRequire="TSP.Isgengriff.Storytime">Herb_Rannar</li>
				<li MayRequire="TSP.Isgengriff.Storytime">Herb_Toadflax</li>
				<li MayRequire="TSP.Isgengriff.Storytime">Herb_Torstol</li>
				<li MayRequire="TSP.Isgengriff.Storytime">Rylex_Tree_CoconutPalm</li>
				<li MayRequire="TSP.Isgengriff.Storytime">Plant_MysteriousFruit</li>
			</value>
		</nomatch>
	</Operation>
</Patch>