	<Operation Class="PatchOperationConditional">
		<!-- Does this exist? -->
		<xpath>Defs/PawnKindDef[defName="Villager_Gnome"]/xenotypeSet</xpath>
		<!-- If it does, do this replacement. -->
		<match Class="PatchOperationReplace">
			<value>
				<xenotypeSet MayRequire="zoid.gnomes,Ludeon.RimWorld.Biotech">
					<xenotypeChances MayRequire="zoid.gnomes,Ludeon.RimWorld.Biotech">
						<Z_Gnomes MayRequire="zoid.gnomes,ludeon.rimworld.biotech">999</Z_Gnomes>
					</xenotypeChances>
					<!-- <warnIfTotalAbove1 MayRequire="ludeon.rimworld.biotech">false</warnIfTotalAbove1> -->
				</xenotypeSet>
			</value>
		</match>
		<!-- If it DOES NOT, add this instead. -->
		<nomatch Class="PatchOperationAdd">
			<xpath>Defs/PawnKindDef[defName="Villager_Gnome"]</xpath>
			<success>Always</success>
			<value>
				<xenotypeSet MayRequire="zoid.gnomes,Ludeon.RimWorld.Biotech">
					<xenotypeChances MayRequire="zoid.gnomes,Ludeon.RimWorld.Biotech">
						<Z_Gnomes MayRequire="zoid.gnomes,ludeon.rimworld.biotech">999</Z_Gnomes>
