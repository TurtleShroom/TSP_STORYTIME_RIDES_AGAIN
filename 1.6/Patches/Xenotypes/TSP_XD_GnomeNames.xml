	<!-- xd.gnomenames -->
	<!-- https://www.steamcommunity.com/sharedfiles/filedetails/?id=3565654933 -->

	<Operation Class="PatchOperationConditional">
	<!-- DO THE GENTILES KNOW? -->
		<xpath>Defs/CultureDef[defName="Gnomish"]</xpath>
		<!-- If they do, SHUT IT DOWN. -->
		<match Class="PatchOperationRemove">
			<xpath>Defs/CultureDef[defName="Gnomish"]</xpath>
			<success>Always</success>
		</match>
		<!-- If the first XPATH does not exist, the original code stands. All according to plan. -->
	</Operation>
	
	<Operation Class="PatchOperationConditional">
	<!-- DO THE GENTILES KNOW? -->
		<xpath>Defs/RulePackDef[defName="XDGnomish_NamerPersonUtility"]</xpath>
		<!-- If they do, SHUT IT DOWN. -->
		<match Class="PatchOperationRemove">
			<xpath>Defs/FactionDef/allowedCultures/li[text()="Gnomish"]</xpath>
			<success>Always</success>
		</match>
		<!-- If the first XPATH does not exist, the original code stands. All according to plan. -->
	</Operation>
	
	
