<?xml version="1.0" encoding="utf-8" ?>

<Patch>
	<Operation Class="PatchOperationConditional">
	<!-- Does this exist? -->
		<xpath>/Defs/HediffDef[defName="VFEI_JellySac"]</xpath>
		<!-- If it does, add this. -->
		<match Class="PatchOperationAdd">
			<success>Always</success>
			<xpath>/Defs</xpath>
			<value>
				<RecipeDef ParentName="SurgeryFlesh">
					<defName>TSP_VFEI_RemoveBodyPart_Jelly</defName>
					<label>remove jelly sac</label>
					<description>Removes a body part. The jelly sac organ is deep in the body, requiring deep surgery and a lot of time to get out. Thankfully, it is fairly easy to reach once the body is opened, but getting there takes more skill than some surgeries.</description>
					<workerClass>Recipe_RemoveHediff</workerClass>
					<jobString>Removing jelly sac</jobString>
					<removesHediff>VFEI_JellySac</removesHediff>
					<workAmount>4000</workAmount>
					<surgerySuccessChanceFactor>3.2</surgerySuccessChanceFactor>
					<developmentalStageFilter>Baby, Child, Adult</developmentalStageFilter>
					<isViolation>false</isViolation> <!-- As the jelly sac organ is really painful -->
					<skillRequirements>
						<Medicine>7</Medicine>
					</skillRequirements>
					<ingredients>
						<li>
							<filter>
								<categories>
									<li>Medicine</li>
								</categories>
							</filter>
							<count>2</count>
						</li>
					</ingredients>
					<fixedIngredientFilter>
						<categories>
							<li>Medicine</li>
						</categories>
					</fixedIngredientFilter>
					<products>
						<VFEI_JellySac>1</VFEI_JellySac>
					</products>
				</RecipeDef>
			</value>
		</match>
		<!-- If the first XPATH does not exist, the original code stands. -->
	</Operation>
	
	<!-- Guaranteeing that the HUMANRECIPEIMPORT feature found in the Humanoid Alien Races Mod inherits these Recipes -->
	<Operation Class="PatchOperationConditional">
	 <!--  Does this exist? -->
		<xpath>/Defs/HediffDef[defName="VFEI_JellySac"]</xpath>
		<match Class="PatchOperationAdd">
			<success>Always</success>
			<xpath>/Defs/ThingDef[defName="Human"]/recipes</xpath>
			<value>
				<li MayRequire="oskarpotocki.vfe.insectoid">TSP_VFEI_RemoveBodyPart_Jelly</li>
			</value>
		</match>
		<!-- If the first XPATH does not exist, the original code stands. -->
	</Operation>
	
	<!-- This allows insane animals to be cured, too. -->
	<Operation Class="PatchOperationConditional">
	<!-- Does this exist/ -->
		<xpath>/Defs/HediffDef[defName="VFEI_JellySac"]</xpath>
		<!-- If it does, add this. -->
		<match Class="PatchOperationAdd">
			<success>Always</success>
			<xpath>/Defs/ThingDef[@Name="AnimalThingBase"]/recipes</xpath>
			<value>
				<li MayRequire="oskarpotocki.vfe.insectoid">TSP_VFEI_RemoveBodyPart_Jelly</li>
			</value>
		</match>
		<!-- If the first XPATH does not exist, the original code stands. -->
	</Operation>
	
	<!-- Guaranteeing that the HUMANRECIPEIMPORT feature found in the Humanoid Alien Races Mod inherits these Recipes -->
	<Operation Class="PatchOperationConditional">
	<!-- Does this exist/ -->
		<xpath>/Defs/AlienRace.ThingDef_AlienRace[defName="Human"]/recipes</xpath>
		<!-- If it does, add this. -->
		<match Class="PatchOperationAdd">
			<success>Always</success>
			<xpath>/Defs/AlienRace.ThingDef_AlienRace[defName="Human"]/recipes</xpath>
			<value>
				<li MayRequire="oskarpotocki.vfe.insectoid">TSP_VFEI_RemoveBodyPart_Jelly</li>
			</value>
		</match>
		<!-- If the first XPATH does not exist, the original code stands. -->
	</Operation>
	
	<Operation Class="PatchOperationConditional">
	<!-- Does this exist? -->
		<xpath>Defs/ThingDef[defName="VFEI2_Swarmling"]</xpath>
		<!-- If it does, add this. -->
		<match Class="PatchOperationAdd">
			<xpath>/Defs</xpath>
			<success>Always</success>
			<value>
				<ThingDef ParentName="EggFertBase">
					<defName>TSP_ST_VEFI_SwarmEgg</defName>
					<label>swarmling egg (fert.)</label>
					<description>A fertilized swarmling egg. Swarmlings are the youngest larval stage of most giant Sorne insects, who then become Insectoid Larvae and finally, emerge from coccoons in their adult forms. This is the first step. If all goes well, this egg should hatch into a Swarmling. It can be eaten raw, but it's much, much better cooked.</description>
					<descriptionHyperlinks>
						<ThingDef>VFEI2_Swarmling</ThingDef>
					</descriptionHyperlinks>
					<graphicData>
						<texPath>Things/Item/Resource/AnimalProductRaw/EggOval</texPath>
						<color>(183,185,153)</color>
						<!-- <graphicClass>Graphic_Single</graphicClass> -->
					</graphicData>
					<statBases>
						<MarketValue>4</MarketValue>
					</statBases>
					<comps>
						<li Class="CompProperties_Hatcher">
							<hatcherDaystoHatch>1</hatcherDaystoHatch>
							<hatcherPawn>VFEI2_Swarmling</hatcherPawn>
						</li>
					</comps>
					<tradeTags>
						<li>ST_Eggs</li>
					</tradeTags>
				</ThingDef>
			</value>
		</match>
		<!-- If the first XPATH does not exist, the original code stands. -->
    </Operation>
</Patch>