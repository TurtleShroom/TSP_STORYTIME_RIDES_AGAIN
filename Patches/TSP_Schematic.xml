<?xml version="1.0" encoding="utf-8"?>

<Patch>
	<Operation Class="PatchOperationConditional">
	<!-- Does this exist? -->
		<xpath>Defs/ThingDef[defName="Schematic"]/comps/li/doers/li/tabs</xpath>
		<!-- If it does, add this. -->
		<match Class="PatchOperationAdd">
			<xpath>Defs/ThingDef[defName="Schematic"]/comps/li/doers/li/tabs</xpath>
			<success>Always</success>
			<value>
				<StoryTime MayRequire="TSP.Isengriff.Storytime"></StoryTime>
			</value>
		</match>
		<!-- If the first XPATH does not exist, the original code stands. -->
	</Operation>
</Patch>